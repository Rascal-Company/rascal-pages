# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Configuration
NEXT_PUBLIC_ROOT_DOMAIN=rascalpages.fi

# Database
DATABASE_URL=your_database_connection_string

# N8N Webhooks (optional)
N8N_RASCALPAGES_LEADS=your_n8n_webhook_url
N8N_LANDINGPAGE_BUILDER=your_n8n_builder_webhook_url

# Blog content ingestion (n8n -> POST /api/posts, sent as "Authorization: Bearer <secret>")
POSTS_INGEST_SECRET=your_long_random_secret

# Waitlist -> Brevo (RAS-1167)
BREVO_API_KEY=
BREVO_WAITLIST_LIST_ID=

# Stripe: sivuston julkaisu 19 €/kk / 190 €/v (RAS-1170)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
# Founding member -40 % 1. vuosi waitlistillä olleille (valinnainen)
STRIPE_FOUNDING_COUPON_ID=
